r-alt__meta player-alt__meta--left ttu"},"children":["Ciclope"]},{"tag":"p","attrs":{"class":"player-alt__meta player-alt__meta--center ttu"},"children":[{"tag":"span","attrs":{"class":"dot--8 dot--white dot--filled dot"},"children":[]}," 3:22"]},{"tag":"p","attrs":{"class":"copyrights player-alt__meta player-alt__meta--right ttu"},"children":["THE LINE © MMXXVI"]},{"tag":"div","attrs":{"class":"player-alt__title h2"},"children":[{"tag":"svg","attrs":{"xmlns":"http://www.w3.org/2000/svg","fill":"currentColor","viewBox":"0 0 75 87","class":"player-alt__title-svg"},"children":[{"tag":"path","attrs":{"d":"M74.25 43.5 0 86.366V.631z"},"children":[]}]},"Play"]}]},{"tag":"div","attrs":{"class":"player-alt__video"},"children":[{"tag":"div","attrs":{"class":"base-video--fit base-video","style":""},"children":[{"tag":"video","attrs":{"height":"1","width":"1","playsinline":"","controls":"","autoplay":"","controlslist":"nodownload noplaybackrate","disablepictureinpicture":"","data-src":"https://player.vimeo.com/progressive_redirect/playback/1016059785/rendition/1080p/file.mp4?loc=external&log_user=0&signature=c2532e4727d61db52acbc45f4a181151f357c9b0785247cb18437659b442bc83"},"children":[]}]}]},{"tag":"span","attrs":{},"children":[]}]},{"tag":"div","attrs":{"class":"case-intro__overview"},"children":[{"tag":"div","attrs":{"class":"module-subtitle-copy--small module-subtitle-copy gutters"},"children":[{"tag":"h2","attrs":{"class":"section-title p7 ttu fw440"},"children":[{"tag":"span","attrs":{"class":"fw300"},"children":["/ "]},"Overview"]},{"tag":"div","attrs":{"class":"structured-text p2 fw440 module-subtitle-copy__content"},"children":[{"tag":"p","attrs":{},"children":["This film was made as the opening to the 2016 Ciclope Festival Awards. It's a story of a small delivery drone carrying a package across a vast ravaged landscape. The film was premiered in Kino International in Berlin with a Live choir on stage. We were inspired by vintage British Travel Posters of the 30s when we were making this film. In particular the works of ",{"tag":"a","attrs":{"rel":"noreferrer noopener","target":"_blank","href":"https://www.google.co.uk/search?q=norman+wilkinson&espv=2&biw=1645&bih=1320&source=lnms&tbm=isch&sa=X&ved=0ahUKEwj_quqxq5nQAhWKIcAKHdSkBeAQ_AUIBigB&dpr=2"},"children":["Norman Wilkinson"]},". The limited palette and very focused handling of colour and composition was something that we wanted to bring into this piece. This choice meant that we could go ahead with a project that normally would be considered too heavy or expensive for the timeframe and resources we had. The colours play a very important role in the film. We tried to make the important decisions early on and wanted to lock down the visuals as much as possible in the rough colour keys. When we entered the CG Build stage we could focus on the shapes and the distribution of them instead of spending precious time on the rendering and shading. The final film retains much of the look and feel of Bjorns colours from these initial paintings.  The different environments were created with a mixture of 2D and 3D elements mixing actual geometry with hand painted elements . Bjorn-Erik Aschim, Marion Bordeyne and Tom Flavelle worked together to define the details of the structures, trees, plants and landscapes. "]}]}]}]}]},{"tag":"div","attrs":{"class":"module-factory","data-v-b402eb9f":""},"children":[{"tag":"div","attrs":{"class":"module-fullwidth grid module-proxy","data-header-theme":"light","data-header-leave":"true"},"children":[{"tag":"figure","attrs":{"class":"module-fullwidth__fig bg-loading"},"children":[{"tag":"picture","attrs":{"class":"base-image"},"children":[{"tag":"img","attrs":{"class":"base-image__img","src":"/assets/1728036101-ciclope_still_thelineanimation-a1615f138f.webp","width":"5100","height":"2132","alt":"","loading":"lazy","decoding":"async","srcset":"/assets/1728036101-ciclope_still_thelineanimation-75aeffcdf0.webp 856w,/assets/1728036101-ciclope_still_thelinean