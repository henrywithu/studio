.com/work/venture"},"children":[{"tag":"u","attrs":{},"children":["Overwatch 2: Venture’s Adventures"]}]},"), the 20-second spot begins as hosts ",{"tag":"a","attrs":{"href":"https://www.antanddec.com/"},"children":[{"tag":"u","attrs":{},"children":["Ant & Dec"]}]}," stand beside a crackling fire. As Ant launches into a monologue celebrating the show’s most iconic campmates, the flames flicker and the film transitions into a surreal animated jungle."]}]}]},{"tag":"p","attrs":{"class":"studio-archive-credit"},"children":["Visual archive / Original work and editorial by ",{"tag":"a","attrs":{"href":"https://thelinestudio.com/","target":"_blank","rel":"noopener"},"children":["THE LINE"]},". Curated within Trapnest Studio."]}]},{"tag":"div","attrs":{"class":"module-factory"},"children":[{"tag":"div","attrs":{"class":"module-fullwidth grid module-proxy","data-header-theme":"light","data-header-leave":"true"},"children":[{"tag":"figure","attrs":{"class":"module-fullwidth__fig bg-loading"},"children":[{"tag":"picture","attrs":{"class":"base-image"},"children":[{"tag":"img","attrs":{"class":"base-image__img","src":"/assets/1773221984-itv_film_stills_review_film_still_06_main_v001_ftrack_revie-a749016932.webp","width":"3424","height":"1926","alt":"","loading":"lazy","decoding":"async","srcset":"/assets/1773221984-itv_film_stills_review_film_still_06_main_v001_ftrack_revie-851418f37b.webp 856w,/assets/1773221984-itv_film_stills_review_film_still_06_main_v001_ftrack_revie-0fbdad64b3.webp 1712w,/assets/1773221984-itv_film_stills_review_film_still_06_main_v001_ftrack_revie-a749016932.webp 3424w","sizes":"(max-width: 3424px) 100vw, 3424px"},"children":[]}]}]}]},{"tag":"div","attrs":{"class":"module-copy-asset--centered module-copy-asset grid module-proxy"},"children":[{"tag":"figure","attrs":{"class":"module-copy-asset__fig"},"children":[{"tag":"picture","attrs":{"class":"base-image"},"children":[{"tag":"img","attrs":{"class":"base-image__img","src":"/assets/1773221984-itv_film_stills_review_film_still_03_main_v001_ftrack_revie-b3c2068bd6.webp","width":"1530","height":"861","alt":"","loading":"lazy","decoding":"async","srcset":"/assets/1773221984-itv_film_stills_review_film_still_03_main_v001_ftrack_revie-caf0cbabab.webp 382w,/assets/1773221984-itv_film_stills_review_film_still_03_main_v001_ftrack_revie-44a92ef3b9.webp 765w,/assets/1773221984-itv_film_stills_review_film_still_03_main_v001_ftrack_revie-b3c2068bd6.webp 1530w","sizes":"(max-width: 1530px) 100vw, 1530px"},"children":[]}]}]},{"tag":"div","attrs":{"class":"module-copy-asset__content"},"children":[{"tag":"div","attrs":{"class":"structured-text p5"},"children":[{"tag":"p","attrs":{},"children":["Amongst the featured returning all stars are ",{"tag":"a","attrs":{"href":"https://www.instagram.com/sirmofarah/?hl=en"},"children":["Sir Mo Farah"]},", ",{"tag":"a","attrs":{"href":"https://www.instagram.com/gemmacollins/?hl=en-gb"},"children":["Gemma Collins"]}," and ",{"tag":"a","attrs":{"href":"https://www.instagram.com/davidhaye/?hl=en"},"children":["David Haye"]},". A core creative challenge lay in designing animated versions of real-life celebrities. “The character design phase was the most crucial and challenging part of this production,” says Producer, Laura Hancock. “It was essential that the celebrities were instantly recognisable, while also fitting cohesively into the bold visual language we envisioned.”"]},{"tag":"p","attrs":{},"children":["The team had to strike a careful balance: achieving accurate likenesses while keeping animation efficient without compromising the energy and humour of the piece. “We wanted fans to point at the screen and shout, ‘I know who that is!’” says JuanPe. “Capturing likeness was essential, but we also wanted the characters to feel unified - almost like their own Celebrity Animated Universe.”"]},{"tag":"p","attrs":{},"children":["The creative approach embraced surreal, high-energy storytelling, leaning into animation’s limitless potential. Quick transitions allow the film to leap effortlessly between explosive jungle chaos and the sweeping desert expanse. The result is a dynamic, nostalgic and joyfully chaotic tribute to one of Britain’s most beloved reality franchises. Proving that even in just 20 seconds, there’s room for jungle legends, desert drama and a whole lot of dirty great big bugs..."]}]},{"tag":"div","attrs":{"class":"module-copy-asset__btns"},"children":[{"tag":"a","attrs":{"href":"/work/itv","class":"arrow-link p1 fw440"},"children":[{"tag":"svg","attrs":{"xmlns":"http://www.w3.org/2000/svg","fill":"currentColor","viewBox":"0 0 22 19","class":"arrow-link__svg arrow-link__svg--clone"},"children":[{"tag":"path","attrs":{"d":"m10.392 16.88 7.232-7.264-7.264-7.232 1.696-1.76 8.992 8.992-8.96 8.992zM.568 8.304h18.4v2.656H.568z"},"children":[]}]},{"tag":"span","attrs":{"class":"arrow-link__label"},"children":["See more! "]},{"tag":"svg","attrs":{"xmlns":"http://www.w3.org/2000/svg","fill":"currentColor","viewBox":"0 0 22 19","class":"arrow-link__svg arrow-link__svg--main"},"children":[{"tag":"path","attrs":{"d":"m10.392 16.88 7.232-7.264-7.264-7.232 1.696-1.76 8.992 8.992-8.96 8.992zM.568 8.304h18.4v2.656H.568z"},"children":[]}]}]}]}]}]}]},{"tag":"footer","attrs":{"class":"footer"},"children":[{"tag":"div","attrs":{"class":"footer__wrapper footer__wrapper--cta gutters"},"children":[{"tag":"a","attrs":{"href":"/contact","class":"footer-cta h1"},"children":[{"tag":"svg","attrs":{"xmlns":"http://www.w3.org/2000/svg","fill":"currentColor","viewBox":"0 0 22 19","class":"footer-cta__svg footer-cta__svg--clone"},"children":[{"tag":"path","attrs":{"d":"m10.392 16.88 7.232-7.264-7.264-7.232 1.696-1.76 8.992 8.992-8.96 8.992zM.568 8.304h18.4v2.656H.568z"},"children":[]}]},{"tag":"span","attrs":{"class":"letter-L footer-cta__label"},"children":[{"tag":"span","attrs":{"class":"text-splitter text-splitter--splitted","data-split-type":"chars","data-split-font":"false","data-split-line":"anim-line","data-split-displ