{
  "name": "trapnest-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-metadata.mjs",
    "postbuild": "node scripts/prepare-workers.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "inspect:reference": "node scripts/inspect-reference.mjs",
    "verify": "node scripts/verify-studio.mjs",
    "verify:images": "node scripts/verify-journal-images.mjs",
    "verify:fidelity": "node scripts/verify-fidelity.mjs",
    "compare": "node scripts/compare-reference.mjs",
    "research:replay": "node scripts/serve-reference.mjs",
    "evidence": "node scripts/export-evidence.mjs",
    "media:plan": "python3 scripts/r2-videos.py plan",
    "media:refresh": "python3 scripts/r2-videos.py refresh",
    "media:upload": "python3 scripts/r2-videos.py upload",
    "media:apply": "python3 scripts/r2-videos.py apply",
    "media:verify": "python3 scripts/r2-videos.py verify",
    "media:test": "node --test scripts/test-r2-media.mjs",
    "media:browser": "node scripts/verify-r2-browser.mjs",
    "media:deploy": "wrangler deploy --config workers/media/wrangler.jsonc",
    "workers:prepare": "node scripts/prepare-workers.mjs",
    "workers:dev": "npm run build && wrangler dev",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "workers:test": "node --test scripts/test-site-worker.mjs"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261006.1-alpha",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wrangler": "^4.149.0"
  }
}
